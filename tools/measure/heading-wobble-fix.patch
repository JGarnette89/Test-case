+/* THE PLAYER'S REFERENCE HEADING ON A PATH, A SMOOTH FUNCTION OF s (13 November, DECISIONS 10.70). A path is a polyline and `poseAt`'s heading is the heading of the SEGMENT, a staircase: the loop's roads are vertices every 5 m turning a uniform 0.48 degrees (an arc of about 600 m),
+   so the segment heading is up to 0.24 degrees either side of the tangent and steps 0.48 at every vertex. The player's heading is `rot + psi` and the camera turns with it, so that staircase was the car's own heading wobble, 0.355 degrees a tick at the 95th percentile
+   on a hands-off drive round a bend at 80 km/h (tools/measure/wobble.mjs). Here the heading is the direction of the chord between the path's POSITIONS HEADING_CHORD metres either side, which is continuous (0.004 degrees a tick, ninety times less). Positions are unchanged: no
+   vertex is added and no path is redrawn. It does not cross the box (the committed arc is the turn's own, as player.js `curvatureOf` has always kept it) and inside the box the segments' heading is kept. Near a path's end the chord is one-sided. ONE FUNCTION: the pose
+   (pose.js) and the car model's frame (drive.js `geomOf`) both read it, or `psi` would be measured against one heading and drawn against another. */
+export const HEADING_CHORD = 5;
+export function smoothHeadingAt(path, s, d = HEADING_CHORD) {
+  if (s >= path.stopAt && s <= path.clearAt) return poseAt(path, s).rot;
+  let s0 = Math.max(0, s - d), s1 = Math.min(path.length, s + d);
+  if (s < path.stopAt) s1 = Math.min(s1, path.stopAt); else s0 = Math.max(s0, path.clearAt);
+  if (s1 - s0 < 1) return poseAt(path, s).rot;
+  const a = poseAt(path, s0), b = poseAt(path, s1);
+  return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
+}
 export { norm as normDeg, bearingOf };
